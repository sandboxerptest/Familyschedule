# Copy to .env and adjust. Every value is optional.

# Household passcode. Leave unset on a trusted home network; set it for any
# install reachable from outside the house.
HEARTH_PIN=

# Extra entropy mixed into session signing. Optional — changing it signs
# everyone out.
HEARTH_SECRET=

# Railway, Fly and friends inject PORT themselves; this is for local runs.
PORT=4321

# Point this at a mounted volume on any host with an ephemeral filesystem,
# e.g. /data/calendar.json on Railway.
HEARTH_DATA=./data/calendar.json

# Set to "off" to start with an empty calendar instead of the demo household.
HEARTH_SEED=
